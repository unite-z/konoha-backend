#!/usr/bin/env bash
# Hook local antes de cada push: formato de lo que cambias y pruebas rápidas (unos segundos).
# Se activa con: git config core.hooksPath .githooks. Compatible con el bash 3.2 de macOS.
# CI repite todo y además las pruebas de integración con PostGIS (ver docs/estandares/pruebas.md).
set -euo pipefail

cero="0000000000000000000000000000000000000000"
base=""
while read -r _ sha_local _ sha_remoto; do
  [[ "$sha_local" == "$cero" ]] && continue
  if [[ "$sha_remoto" != "$cero" ]]; then
    base="$sha_remoto"
  else
    base="$(git merge-base "$sha_local" origin/main 2>/dev/null || git merge-base "$sha_local" main 2>/dev/null || true)"
  fi
  break
done
[[ -z "$base" ]] && exit 0

if ! java -version 2>&1 | grep -q 'version "21'; then
  echo "pre-push: el backend necesita Java 21 (java -version dice otra cosa). Configura JAVA_HOME (docs/arranque-local.md)." >&2
  echo "pre-push: si tienes un motivo justificado, puedes saltarte el hook con: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: formato de lo cambiado y pruebas rápidas..." >&2
if ! ./mvnw -B -q -ntp -Ppruebas-rapidas -Dspotless.ratchetFrom="$base" spotless:check test; then
  echo "" >&2
  echo "pre-push: algo falla." >&2
  echo "  Formato:  ./mvnw spotless:apply -Dspotless.ratchetFrom=$base   (y haz commit del resultado)" >&2
  echo "  Pruebas:  ./mvnw -Ppruebas-rapidas test" >&2
  echo "Si tienes un motivo justificado, puedes saltarte el hook con: git push --no-verify (CI lo comprobará igual)." >&2
  exit 1
fi
