# Fuente de datos del MOD-06: mock | db
DATA_SOURCE=mock

# Ruta a la carpeta de datos simulados (relativa a backend/)
MOCK_DATA_DIR=../mock-data

# Django
DJANGO_SECRET_KEY=cambiar-en-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (DATA_SOURCE=db o TERCERIZADOS_ENABLED=True)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gemini (Google AI Studio). La clave NUNCA se versiona.
GEMINI_API_KEY=
# Nombre del modelo tal como aparece en Google AI Studio (se decide al programar RF-IA-001)
GEMINI_MODEL=

# MOD-05 (PostgreSQL independiente de DATA_SOURCE del MOD-06)
TERCERIZADOS_ENABLED=False
# Directorio privado: no servir desde el servidor web
TERCERIZADOS_ARCHIVOS_DIR=
TERCERIZADOS_MAX_ARCHIVO_BYTES=20971520
