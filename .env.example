# Fuente de datos del MOD-06: mock | db
DATA_SOURCE=mock

# Ruta a la carpeta de datos simulados (relativa a backend/)
MOCK_DATA_DIR=../mock-data

# Django
DJANGO_SECRET_KEY=cambiar-en-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (solo para DATA_SOURCE=db del MOD-06; aún pendiente de implementación)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gemini (Google AI Studio). La clave NUNCA se versiona.
GEMINI_API_KEY=
# Nombre del modelo tal como aparece en Google AI Studio (se decide al programar RF-IA-001)
GEMINI_MODEL=
