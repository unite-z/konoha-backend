# Fuente de datos del MOD-06: mock | db
DATA_SOURCE=mock

# Ruta a la carpeta de datos simulados (relativa a la raíz del repo)
MOCK_DATA_DIR=mock-data

# Puerto HTTP del back-end (por defecto 8000)
PORT=8000

# PostgreSQL (solo para DATA_SOURCE=db del MOD-06; aún pendiente de implementación)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gemini (Google AI Studio). La clave NUNCA se versiona.
GEMINI_API_KEY=
# Nombre del modelo tal como aparece en Google AI Studio (se decide al programar RF-IA-001)
GEMINI_MODEL=
# Razonamiento de Gemini: minimal | low | medium | high (vacío: lo decide el modelo). Menos = más rápido
GEMINI_THINKING_LEVEL=low

# RF-IA-001 lee el reporte y su informe de: mod05 (base y archivos reales del MOD-05) | mock (mock-data, como antes)
IA_FUENTE_REPORTES=mod05

# MOD-05 «Atenciones tercerizadas» (PostgreSQL). No poner comillas alrededor de los valores. No versionar contraseñas.
MOD05_DB_URL=jdbc:postgresql://localhost:5432/areas_verdes_mod05
MOD05_DB_USER=areas_verdes
MOD05_DB_PASSWORD=
MOD05_ARCHIVOS_DIR=./private-media
MOD05_MAX_ARCHIVO_BYTES=20971520
MOD05_MAX_FILE_SIZE=20MB
MOD05_MAX_REQUEST_SIZE=100MB
MOD05_MOCK_DATA=mock-data
# Solo precarga con perfil dev y --mod05.seed=true; mínimo 12 caracteres.
MOD05_DEMO_PASSWORD=

# MOD-01 «Core y seguridad». Con perfil dev se entra con las cuentas de MOD-05 (mod05_jefe...) y su clave.
# Opcional: además, una cuenta por rol (jefe@, ingeniero@, practicante@ y capataz@pucp.edu.pe) con esta clave.
MOD01_DEMO_PASSWORD=
# Cookie de sesión con Secure. En local se sirve por http y Safari no la guarda: false. UAT y prod no usan
# este fichero y quedan con el valor por defecto (true).
CORE_COOKIE_SEGURA=false
