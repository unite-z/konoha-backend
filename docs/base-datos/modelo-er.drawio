<mxCell id="mod05_leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK clave primaria · FK clave foránea · U único&lt;br&gt;&lt;code&gt;?&lt;/code&gt; admite nulos&lt;br&gt;Colores: &lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;seguridad y auditoría&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;operación&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#fff2cc&quot;&gt;&amp;nbsp;catálogos y configuración&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;reportes y archivos&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#f5f5f5&quot;&gt;&amp;nbsp;copia provisional&amp;nbsp;&lt;/span&gt;&lt;br&gt;Borde discontinuo: tabla de otro módulo (solo la clave referenciada)&lt;br&gt;&lt;span style=&quot;color:#999;&quot;&gt;→ tabla&lt;/span&gt;: FK que no se dibuja como línea (auditoría o tabla de otra página)" style="rounded=1;arcSize=4;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1494" y="796" width="360" height="135" as="geometry"/></mxCell>
<mxCell id="mod05_reglas" value="&lt;b&gt;Reglas de la base de datos (CHECK)&lt;/b&gt;&lt;br&gt;contrato: vigencia_fin ≥ vigencia_inicio&lt;br&gt;contrato_detalle: monto_fijo ≥ 0&lt;br&gt;proveedor_detalle: SinVinculo o Principal sin proveedor relacionado; Subsidiaria y Vinculada con él&lt;br&gt;atención: fecha_hora_fin ≥ fecha_hora_inicio&lt;br&gt;atención: origen SolicitudUnidad exige unidad_solicitante_id; Demanda y ProgramacionEstacional la dejan vacía&lt;br&gt;alcance: área verde o ejemplar, nunca los dos&lt;br&gt;alcance: metrado y unidad_medida_id van juntos (metrado ≥ 0)&lt;br&gt;atención especial: 1 o 2 aplicaciones adicionales; realizadas entre 0 y las adicionales&lt;br&gt;archivo: tamano_bytes ≥ 0; reporte: revision ≥ 0&lt;br&gt;usuario_rol.rol: Jefe de sección, Ingeniero de campo o Practicante autorizado" style="rounded=1;arcSize=4;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1494" y="971" width="360" height="231" as="geometry"/></mxCell>
