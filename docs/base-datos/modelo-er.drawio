<mxCell id="mod06_leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK clave primaria · FK clave foránea · U único&lt;br&gt;&lt;code&gt;?&lt;/code&gt; admite nulos&lt;br&gt;Colores: &lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;seguridad y auditoría&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;operación&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#fff2cc&quot;&gt;&amp;nbsp;catálogos y configuración&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;reportes y archivos&amp;nbsp;&lt;/span&gt; &lt;span style=&quot;background:#f5f5f5&quot;&gt;&amp;nbsp;copia provisional&amp;nbsp;&lt;/span&gt;&lt;br&gt;Borde discontinuo: tabla de otro módulo (solo la clave referenciada)&lt;br&gt;&lt;span style=&quot;color:#999;&quot;&gt;→ tabla&lt;/span&gt;: FK que no se dibuja como línea (auditoría o tabla de otra página)" style="rounded=1;arcSize=4;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="535" y="270" width="360" height="135" as="geometry"/></mxCell>
<mxCell id="mod06_reglas" value="&lt;b&gt;Reglas de la base de datos (CHECK)&lt;/b&gt;&lt;br&gt;reporte: tipo GestionOSG, ServicioTercerizado, MaterialVegetal, DistribucionPersonal, MatrizIncidencias o Listado&lt;br&gt;reporte: formato PDF o Excel; filas y archivo_tamano_bytes ≥ 0&lt;br&gt;sugerencia: estado Propuesta, Validada o Rechazada; validada o rechazada exige validador y fecha&lt;br&gt;sugerencia.tipo: ExtraccionReporte, Priorizacion, Inconsistencia, Cronograma, EstimacionRecursos, ClasificacionIncidencia o EvidenciaFitosanitaria&lt;br&gt;sugerencia: entidad y registro_id van juntos" style="rounded=1;arcSize=4;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="535" y="445" width="360" height="166" as="geometry"/></mxCell>
