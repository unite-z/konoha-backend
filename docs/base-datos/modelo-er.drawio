<diagram id="mod06" name="MOD-06 · Reportes e IA"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="955" pageHeight="892" math="0" shadow="0"><root>
